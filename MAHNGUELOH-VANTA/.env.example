# ════════════════════════════════════════════════════════════════════════════
# MAHNGUELOH VANTA — Environment Configuration
# ════════════════════════════════════════════════════════════════════════════
#
# Copy relevant lines into your REAL .env file and fill in YOUR values there.
# .env is NEVER committed to git and is NEVER overwritten by a redeploy.
# Every other .js file WILL be overwritten, so never put real keys in code.
#
# After editing .env you MUST RESTART the bot — env vars are read once at startup
# (index.js calls dotenv.config()).
#
# If on a hosting panel (Pterodactyl, Railway, etc.) check whether it has a
# separate "Variables" / "Environment" tab — some panels have their own env
# injection at container start, which can override or ignore this file.
# ════════════════════════════════════════════════════════════════════════════

# ── AUTHENTICATION (ONE of these two is required to start the bot) ──────────

# Option 1: SESSION_ID (recommended for first-time setup)
# Get a fresh session ID from: https://mahngueloh-md-session.onrender.com/
# It's a long MAHNGUELOH~... string. Paste the ENTIRE thing here (3000+ chars).
SESSION_ID=

# Option 2: PHONE_NUMBER (alternative: direct WhatsApp number pairing)
# Your WhatsApp number in digits-only format WITH country code, no +.
# Examples: 254712345678 (Kenya), 2347012345678 (Nigeria), 447911123456 (UK)
PHONE_NUMBER=

# ── CORE BOT SETTINGS ──────────────────────────────────────────────────────

BOT_NAME=MAHNGUELOH VANTA
OWNER_NAME=MAHNGUELOH
OWNER_NUMBER=                # Your WhatsApp number (digits, country code, no +)
MODE=private                 # 'private' = owner-only commands, 'public' = anyone can use
REPAIR_ADMIN_NUMBER=         # Special admin for .repair command (leave blank if not needed)

# ── AI PROVIDERS (all OPTIONAL — the bot works without any keys!) ──────────────
#
# QUICK START: Leave all blank and the bot works via the Savage relay.
#
# Deeper control: Add only the keys you want. The bot chains through providers
# in order, falling through to the next if one fails or is missing:
#   1. Claude (Anthropic) — requires ANTHROPIC_API_KEY
#   2. OpenAI — requires OPENAI_API_KEY
#   3. Gemini (Google) — requires GEMINI_API_KEY
#   4. DeepSeek — requires DEEPSEEK_API_KEY
#   5. Savage relay — no key needed (public fallback, text-only, no vision)
#
# Vision (image input) support:
#   ✓ Claude (official key required)
#   ✓ OpenAI (official key required)
#   ✓ Gemini (official key required)
#   ✗ DeepSeek (text-only)
#   ✗ Savage relay (text-only)
#
# If you want vision AND a fallback, set at least Claude or OpenAI.

# Anthropic (Claude Sonnet 4)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (GPT-4o mini + vision)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Google Gemini (vision-capable)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash

# DeepSeek (text-only, no vision)
DEEPSEEK_API_KEY=

# Control the order AI providers are tried (comma-separated provider names):
AI_PROVIDER_ORDER=claude,openai,gemini,deepseek

# Advanced: The Savage relay is a public third-party proxy (no official keys needed).
# It handles Claude & DeepSeek text-only with NO setup. If you trust it, leave
# SAVAGE_API_KEY set to the default. If you want to disable it, set it to empty.
# Do NOT change this unless you're managing your own Savage instance.
SAVAGE_API_KEY=savage_573248
SAVAGE_API_BASE=https://savage-api-production.up.railway.app

# ── OPTIONAL: REMOVE.BG IMAGE PROCESSING ──────────────────────────────────

# For advanced image features (e.g. background removal)
REMOVEBG_API_KEY=

# ── NEWS MONITOR (auto-posting breaking news) ─────────────────────────────

# Enable news monitoring on startup (can be toggled later with .news on/off)
NEWS_MONITOR_ENABLED=false

# WhatsApp Channel JID to post news (e.g., 123456789@newsletter)
WHATSAPP_CHANNEL_JID=

# WhatsApp group to auto-join (invite link):
UPDATES_GROUP_INVITE_LINK=https://chat.whatsapp.com/GyKGFr0Aclb0koqLNzHOLn

# Check interval in milliseconds (default 45 seconds)
NEWS_CHECK_INTERVAL_MS=45000

# News display branding (customize the look of news images)
NEWS_WATERMARK_ENABLED=true
NEWS_SOCIAL_HANDLE=@mahnguelohnews
NEWS_SLOGAN=FAST. ACCURATE. TRENDING.
NEWS_SOURCE_URL=
NEWS_SOURCE_NAME=
NEWS_DEFAULT_CATEGORY=
NEWS_BANNER_BG=#111111
NEWS_BANNER_TEXT_COLOR=#ffffff
NEWS_WATERMARK_BG=#000000
NEWS_WATERMARK_TEXT_COLOR=#ffffff
NEWS_WATERMARK_TEXT=

# Telegram news integration (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ── FACEBOOK (optional) ────────────────────────────────────────────────────

FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_AUTO_POST=false
FACEBOOK_API_VERSION=v19.0

# ── MISC SETTINGS ──────────────────────────────────────────────────────────

# Max download size in MB (e.g. video, audio)
MAX_DOWNLOAD_MB=80

# Command cooldown in milliseconds (per user)
COOLDOWN_MS=3000

# Timezone for timestamps and scheduling
TIMEZONE=Africa/Nairobi

# Comma-separated sudo numbers (power users, no cooldown, bypass some restrictions)
SUDO_NUMBERS=

