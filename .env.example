# Railway supplies PORT automatically. Do NOT set it in Railway.
PORT=3000

# Public URL of your service, e.g. https://your-app.up.railway.app (optional; auto-detected if empty)
BASE_URL=

# REQUIRED: long random secret that controls API-key creation.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Optional: a shared test key. Leave EMPTY in production.
DEMO_API_KEY=

# Where API keys are saved. Mount a Railway Volume (e.g. at /data) and set DATA_DIR=/data
# so keys survive redeploys. Without a volume, keys are lost on every deploy.
DATA_DIR=

# Limits
MAX_FILE_MB=100
DOWNLOAD_TIMEOUT_MS=30000
DOWNLOAD_TOTAL_TIMEOUT_MS=120000
FILE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_DOWNLOADS=5
MAX_STORAGE_MB=500
