# Railway supplies PORT automatically. Do NOT set it in Railway.
PORT=3000

# Public URL of your service, e.g. https://your-app.up.railway.app (optional; auto-detected if empty)
BASE_URL=

# REQUIRED: long random secret that controls API-key creation.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Optional: a shared test key. Leave EMPTY in production.
DEMO_API_KEY=

# Where API keys are saved. Mount a Railway Volume (e.g. at /data) and set DATA_DIR=/data
# so keys survive redeploys. Without a volume, keys are lost on every deploy.
DATA_DIR=

# Limits
MAX_FILE_MB=100
DOWNLOAD_TIMEOUT_MS=30000
DOWNLOAD_TOTAL_TIMEOUT_MS=120000
FILE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_DOWNLOADS=5
MAX_STORAGE_MB=500

# ---- AI gateway (POST /v1/ai and the /ai/* routes) ----
# Set at least ONE provider. They are tried in AI_PROVIDER_ORDER.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Any OpenAI-compatible API (DeepSeek, Groq, OpenRouter, OpenAI...):
#   COMPAT_BASE_URL=https://api.deepseek.com  COMPAT_MODEL=deepseek-chat
COMPAT_BASE_URL=
COMPAT_MODEL=
COMPAT_API_KEY=
AI_PROVIDER_ORDER=gemini,anthropic,compat
# Identity the AI uses when no system prompt is sent
AI_NAME=MAHNGUELOH VANTA
AI_OWNER=MAHNGUELOH
AI_RATE_PER_MINUTE=20

# ---- Sports (football-data.org proxy: /sports/*) ----
# Free token: https://www.football-data.org/client/register  (check their terms for your use)
FOOTBALL_DATA_TOKEN=
# Sports routes are public by default so existing bots keep working. Set true to require an API key.
SPORTS_REQUIRE_KEY=false
SPORTS_RATE_PER_MINUTE=30
# Max calls to the sports provider per minute (free plan allows 10)
SPORTS_UPSTREAM_PER_MINUTE=8
# Shown as "operator" in JSON replies
OPERATOR_NAME=MAHNGUELOH

# ---- Music search (/music/search) ----
# Openverse works with no key. Add a free Jamendo client id for full-length independent tracks:
# https://developer.jamendo.com  (Jamendo's API terms limit commercial use, check them)
JAMENDO_CLIENT_ID=
